# -----------------------------
# Cube.js Configuration
# -----------------------------
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_SECRET=your-cube-api-secret
CUBEJS_API_SECRET=your-cubejs-secret

# -----------------------------
# App Security
# -----------------------------
APP_JWT_SECRET=your-jwt-secret

# -----------------------------
# Database Configuration
# -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password

# -----------------------------
# Cube Query Settings
# -----------------------------
CUBE_REQUEST_TIMEOUT=30.0
CUBE_MAX_ROWS=10000

# -----------------------------
# AI / LLM Configuration
# -----------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_ID=claude-haiku-4-5

# -----------------------------
# Observability (Arize)
# -----------------------------
ARIZE_API_KEY=your-arize-api-key

# -----------------------------
# DSPy Configuration
# -----------------------------
USE_DSPY=true
DSPY_AGENT_LOGGING=true
DSPY_CACHE_ENABLED=true
DSPY_LOG_LEVEL=INFO
DSPY_LOG_FILE=logs/dspy_agents.log